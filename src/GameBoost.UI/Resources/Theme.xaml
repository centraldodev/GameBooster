<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="Surface" Color="#182130"/>
<Style TargetType="Window"><Setter Property="Background" Value="#0E1520"/><Setter Property="Foreground" Value="#EEF3FA"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
<Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,6,10,6"/><Setter Property="Background" Value="#C2F970"/><Setter Property="Foreground" Value="#142013"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF3FA"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
<Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="24"/></Style>
<Style TargetType="TabItem"><Setter Property="Padding" Value="15,10"/><Setter Property="Foreground" Value="#142013"/></Style>
<DataTemplate x:Key="OptimizationCard"><Border Background="#202D40" Padding="16" Margin="0,6" CornerRadius="8"><StackPanel><CheckBox Content="{Binding Info.Name}" IsChecked="{Binding Selected}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Info.Description}" Foreground="#BECBDD"/><TextBlock Text="{Binding RiskLabel}" Foreground="#C2F970" FontSize="12"/></StackPanel></Border></DataTemplate>
</ResourceDictionary>
