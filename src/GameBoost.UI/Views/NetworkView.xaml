<UserControl x:Class="GameBoost.UI.Views.NetworkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Rede e latência" FontSize="24"/>
<TextBlock Text="Destino IP para diagnóstico e benchmark"/><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Medir 20 amostras · ping, jitter e perda" Command="{Binding DiagnoseCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding NetworkSummary}" Foreground="#C2F970"/><TextBlock Text="Jitter é a média das diferenças absolutas entre respostas consecutivas. ICMP pode ser bloqueado ou ter prioridade diferente do tráfego do jogo." Foreground="#A8B6CC"/>
<Button Content="Testar DNS · Cloudflare / Google / Quad9" Command="{Binding TestDnsCommand}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding DnsResults}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock><Run Text="{Binding Server}"/><Run Text=" · "/><Run Text="{Binding Milliseconds, StringFormat={}{0:F1}}"/><Run Text=" ms"/></TextBlock><TextBlock Text="{Binding Status}" Foreground="#A8B6CC"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Interface para DNS / ajustes TCP" FontSize="18"/><Button Content="Carregar interfaces ativas" Command="{Binding RefreshAdaptersCommand}" HorizontalAlignment="Left"/><ComboBox ItemsSource="{Binding Adapters}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding InterfaceId}" Margin="0,8" Padding="8"/>
<TextBlock Text="DNS primário IPv4"/><TextBox Text="{Binding DnsPrimary, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="DNS secundário IPv4 (opcional)"/><TextBox Text="{Binding DnsSecondary, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="A troca depende de marcar DNS abaixo e confirmar a revisão. IPv6 permanece intacto. Evite trocar DNS em rede corporativa/VPN sem conhecer os requisitos de nomes internos." Foreground="#A8B6CC"/>
<ItemsControl ItemsSource="{Binding NetworkOptions}" ItemTemplate="{StaticResource OptimizationCard}"/><WrapPanel><Button Content="Salvar seleção no perfil" Command="{Binding SaveCommand}"/><Button Content="Revisar e aplicar" Command="{Binding ApplyCommand}"/><Button Content="Limpar cache DNS" Command="{Binding FlushDnsCommand}"/></WrapPanel><TextBlock Text="Limpar cache DNS é uma ação imediata: não é desfeita, e as entradas são reconstruídas nas próximas consultas." Foreground="#A8B6CC"/></StackPanel></ScrollViewer></UserControl>
