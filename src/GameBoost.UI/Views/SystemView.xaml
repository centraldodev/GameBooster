<UserControl x:Class="GameBoost.UI.Views.SystemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Ajustes do Windows" FontSize="24"/><TextBlock Text="Marcar não aplica: os ajustes entram na revisão do perfil. Todos são opcionais e possuem restauração." Foreground="#A8B6CC"/>
<TextBlock Text="Resolução alvo (somente se o ajuste de resolução estiver marcado)"/><WrapPanel><TextBox Width="120" Text="{Binding ResolutionWidth, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text=" × " Margin="10"/><TextBox Width="120" Text="{Binding ResolutionHeight, UpdateSourceTrigger=PropertyChanged}"/></WrapPanel>
<ItemsControl ItemsSource="{Binding SystemOptions}" ItemTemplate="{StaticResource OptimizationCard}"/>
<TextBlock Text="Agendamento de GPU exige avaliação e reinício: use as configurações do Windows. Limpeza de temporários não entra na sessão reversível; standby RAM e prioridade de processo seguem fora do catálogo. Não perturbamos a segurança do Windows nem o anti-cheat." Foreground="#A8B6CC"/>
<WrapPanel><Button Content="Salvar seleção no perfil" Command="{Binding SaveCommand}"/><Button Content="Revisar e aplicar" Command="{Binding ApplyCommand}"/></WrapPanel></StackPanel></ScrollViewer></UserControl>
