<UserControl x:Class="GameBoost.UI.Views.GamesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Meus jogos" FontSize="22"/><ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" MinHeight="130"/><Button Content="Novo perfil" Command="{Binding NewCommand}"/>
<TextBlock Text="Jogos instalados" FontSize="18"/><Button Content="Detectar Steam / Epic / GOG" Command="{Binding DiscoverCommand}"/><ListBox ItemsSource="{Binding DiscoveredGames}" SelectedItem="{Binding SelectedDiscoveredGame}" DisplayMemberPath="Name" Height="150"/><Button Content="Importar e selecionar .exe" Command="{Binding ImportGameCommand}"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Perfil de jogo" FontSize="24"/><TextBlock Text="Nome"/><TextBox Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Executável para iniciar"/><TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Selecionar .exe" Command="{Binding BrowseCommand}" HorizontalAlignment="Left"/>
<TextBlock Text="Argumentos de inicialização (opcional)"/><TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Executável real para monitorar (opcional, diferente do launcher)"/><TextBox Text="{Binding MonitorExecutable, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Selecionar processo real" Command="{Binding BrowseMonitorCommand}" HorizontalAlignment="Left"/>
<CheckBox Content="Este jogo usa anti-cheat · Modo Seguro" IsChecked="{Binding AntiCheat}"/><CheckBox Content="Restaurar automaticamente ao fechar o jogo" IsChecked="{Binding AutoRestore}"/><CheckBox Content="Tentar criar ponto de restauração antes dos ajustes" IsChecked="{Binding CreateRestorePoint}"/>
<TextBlock Text="O GameBoost precisa continuar aberto. Se o processo não aparecer em 2 minutos, a sessão falha e tenta restaurar os ajustes. No encerramento normal, a opção do perfil é respeitada. O jogo é iniciado pelo Explorer, sem herdar a elevação do GameBoost. A compatibilidade com anti-cheat precisa ser validada por jogo." Foreground="#A8B6CC"/>
<WrapPanel><Button Content="Salvar perfil" Command="{Binding SaveCommand}"/><Button Content="Revisar e iniciar jogo" Command="{Binding LaunchCommand}"/><Button Content="Só aplicar ajustes" Command="{Binding ApplyCommand}"/></WrapPanel></StackPanel>
</Grid></ScrollViewer></UserControl>
