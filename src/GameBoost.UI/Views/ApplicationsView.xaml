<UserControl x:Class="GameBoost.UI.Views.ApplicationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Aplicativos e serviços" FontSize="24"/>
<TextBlock Text="Somente janelas de aplicativos da lista permitida, na sua sessão. Launchers, sistema, segurança e anti-cheats não entram na lista. Fechar aplicativo não recupera trabalho e não é desfeito pelo snapshot." Foreground="#A8B6CC"/>
<Button Content="Atualizar janelas elegíveis" Command="{Binding RefreshAppsCommand}" HorizontalAlignment="Left"/><ListBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" Height="160"><ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Name}"/><Run Text=" · "/><Run Text="{Binding Title}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox>
<Button Content="Revisar e solicitar fechamento" Command="{Binding CloseAppCommand}" HorizontalAlignment="Left"/>
<TextBlock Text="Serviços · pausa temporária" FontSize="20"/><TextBlock Text="Selecione para a próxima ativação. O estado anterior será registrado no snapshot. Serviços com dependentes ativos, em transição ou sem permissão de parada são recusados. O Windows pode reiniciar serviços por conta própria." Foreground="#A8B6CC"/>
<Button Content="Consultar estado dos serviços permitidos" Command="{Binding RefreshServicesCommand}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding Services}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Name}"/><Run Text=" · "/><Run Text="{Binding Status}"/><Run Text=" · "/><Run Text="{Binding DisplayName}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<ItemsControl ItemsSource="{Binding ServiceOptions}" ItemTemplate="{StaticResource OptimizationCard}"/><WrapPanel><Button Content="Salvar seleção no perfil" Command="{Binding SaveCommand}"/><Button Content="Revisar e aplicar" Command="{Binding ApplyCommand}"/></WrapPanel></StackPanel></ScrollViewer></UserControl>
